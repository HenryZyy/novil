# Copy to .env and adjust: cp .env.example .env
# Used by `go run ./cmd/novil` (from apps/backend) and by docker compose.
# Variables already set in the environment take precedence over this file.

# Leave NOVIL_ADDR and NOVIL_DATA_DIR unset unless you need to: the defaults
# (:8080 and ./data) suit local development, and in Docker the image sets
# NOVIL_DATA_DIR=/config, which a value here would override.
# NOVIL_ADDR=:8080
# NOVIL_DATA_DIR=data
